@{
    ViewData["Title"] = "Admin Panel";
}

<section class="why-section">

    <div class="section-heading">
        <h1>👑 Admin Panel</h1>
        <p>Welcome to the Digital Literacy Training Admin Panel.</p>
    </div>

    <div class="feature-grid">

        <div class="feature-card">
            <div class="feature-icon">📊</div>
            <h3>Survey Responses</h3>
            <p>View all survey responses submitted by users.</p>

            <a href="/Home/SurveyResponses"
               class="btn btn-primary-custom">
                View Survey Responses
            </a>
        </div>

        <div class="feature-card">
            <div class="feature-icon">👥</div>
            <h3>User Management</h3>
            <p>Manage registered users and their account details.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📚</div>
            <h3>Learning Modules</h3>
            <p>Manage digital literacy learning content.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🎥</div>
            <h3>Video Tutorials</h3>
            <p>Manage tutorial videos for senior citizens.</p>
        </div>

    </div>

</section>