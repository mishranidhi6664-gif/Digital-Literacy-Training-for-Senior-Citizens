@{
    ViewData["Title"] = "Digital Literacy Survey";
}

<section class="why-section">

    <div class="section-heading">

        <h1>📋 Digital Literacy Survey</h1>

        <p>
            Please answer these simple questions to help us understand
            your experience with digital technology.
        </p>

    </div>


    <div class="survey-container">

        <form method="post" action="/Home/SubmitSurvey" id="surveyForm">


            <!-- Question 1 -->

            <div class="survey-question">

                <h3>1. Do you use a smartphone?</h3>

                <label>
                    <input type="radio" name="Q1" value="Yes" required>
                    Yes
                </label>

                <label>
                    <input type="radio" name="Q1" value="No">
                    No
                </label>

            </div>


            <!-- Question 2 -->

            <div class="survey-question">

                <h3>2. How often do you use the internet?</h3>

                <label>
                    <input type="radio" name="Q2" value="Daily" required>
                    Daily
                </label>

                <label>
                    <input type="radio" name="Q2" value="Sometimes">
                    Sometimes
                </label>

                <label>
                    <input type="radio" name="Q2" value="Rarely">
                    Rarely
                </label>

                <label>
                    <input type="radio" name="Q2" value="Never">
                    Never
                </label>

            </div>


            <!-- Question 3 -->

            <div class="survey-question">

                <h3>3. Which digital activity do you use most?</h3>

                <label>
                    <input type="radio" name="Q3" value="Calling" required>
                    Calling
                </label>

                <label>
                    <input type="radio" name="Q3" value="WhatsApp">
                    WhatsApp
                </label>

                <label>
                    <input type="radio" name="Q3" value="Internet">
                    Internet Browsing
                </label>

                <label>
                    <input type="radio" name="Q3" value="Payments">
                    Digital Payments
                </label>

            </div>


            <!-- Question 4 -->

            <div class="survey-question">

                <h3>4. Have you ever used a digital payment service?</h3>

                <label>
                    <input type="radio" name="Q4" value="Yes" required>
                    Yes
                </label>

                <label>
                    <input type="radio" name="Q4" value="No">
                    No
                </label>

            </div>


            <!-- Question 5 -->

            <div class="survey-question">

                <h3>5. Do you know how to use a QR code for payment?</h3>

                <label>
                    <input type="radio" name="Q5" value="Yes" required>
                    Yes
                </label>

                <label>
                    <input type="radio" name="Q5" value="No">
                    No
                </label>

                <label>
                    <input type="radio" name="Q5" value="Little">
                    I know a little
                </label>

            </div>


            <!-- Question 6 -->

            <div class="survey-question">

                <h3>6. Do you know that OTP and UPI PIN should be kept private?</h3>

                <label>
                    <input type="radio" name="Q6" value="Yes" required>
                    Yes
                </label>

                <label>
                    <input type="radio" name="Q6" value="No">
                    No
                </label>

            </div>


            <!-- Question 7 -->

            <div class="survey-question">

                <h3>7. What is your biggest difficulty while using technology?</h3>

                <label>
                    <input type="radio" name="Q7" value="Understanding" required>
                    Understanding new features
                </label>

                <label>
                    <input type="radio" name="Q7" value="Safety">
                    Fear of online fraud
                </label>

                <label>
                    <input type="radio" name="Q7" value="Physical">
                    Difficulty using the device
                </label>

                <label>
                    <input type="radio" name="Q7" value="None">
                    No major difficulty
                </label>

            </div>


            <!-- Question 8 -->

            <div class="survey-question">

                <h3>8. Would you like to receive digital literacy training?</h3>

                <label>
                    <input type="radio" name="Q8" value="Yes" required>
                    Yes
                </label>

                <label>
                    <input type="radio" name="Q8" value="No">
                    No
                </label>

                <label>
                    <input type="radio" name="Q8" value="Maybe">
                    Maybe
                </label>

            </div>


            <!-- Question 9 -->

            <div class="survey-question">

                <h3>9. How confident are you when using digital services?</h3>

                <label>
                    <input type="radio" name="Q9" value="Very" required>
                    Very Confident
                </label>

                <label>
                    <input type="radio" name="Q9" value="Somewhat">
                    Somewhat Confident
                </label>

                <label>
                    <input type="radio" name="Q9" value="Not">
                    Not Confident
                </label>

            </div>


            <!-- Question 10 -->

            <div class="survey-question">

                <h3>10. Do you think digital literacy improves daily life?</h3>

                <label>
                    <input type="radio" name="Q10" value="Yes" required>
                    Yes
                </label>

                <label>
                    <input type="radio" name="Q10" value="No">
                    No
                </label>

                <label>
                    <input type="radio" name="Q10" value="NotSure">
                    Not Sure
                </label>

            </div>


            <!-- Submit -->

            <div class="survey-submit">

                <button type="submit"
                        class="btn btn-primary-custom">

                    Submit Survey

                </button>

            </div>

        </form>


        <!-- Back to Home -->

        <div class="survey-back">

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-primary-custom">

                ← Back to Home

            </a>

        </div>

    </div>

</section>