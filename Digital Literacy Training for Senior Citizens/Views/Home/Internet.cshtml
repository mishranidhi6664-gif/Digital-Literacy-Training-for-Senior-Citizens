@{
    ViewData["Title"] = "Internet Skills";
}

<section class="why-section">

    <div class="section-heading">
        <h1>🌐 Internet Skills</h1>
        <p>
            Learn how to use the internet safely and confidently.
        </p>
    </div>

    <div class="feature-grid">

        <div class="feature-card">
            <div class="feature-icon">🔍</div>
            <h3>Step 1: Search for Information</h3>
            <p>
                Open a web browser and type what you want to search.
                Check the information carefully before trusting it.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🌐</div>
            <h3>Step 2: Open a Website</h3>
            <p>
                Tap or click a trusted website link to open it.
                Make sure the website address looks correct.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📧</div>
            <h3>Step 3: Use Email</h3>
            <p>
                Learn how to open your email, read messages,
                reply to messages and send an email.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🏥</div>
            <h3>Step 4: Use Online Services</h3>
            <p>
                Learn how to access useful online services such as
                healthcare, government services and information portals.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🔐</div>
            <h3>Step 5: Browse Safely</h3>
            <p>
                Do not open unknown links or download suspicious files.
                Always use trusted websites.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">💡</div>
            <h3>Step 6: Ask for Help</h3>
            <p>
                If you are unsure about a website or message,
                ask a trusted family member or trainer for help.
            </p>
        </div>

    </div>

    <div class="about-section">

        <h2>💡 Internet Safety Tip</h2>

        <p>
            Never share your password, OTP, PIN or banking details with
            anyone through an unknown website, message or phone call.
        </p>

        <a href="/Home/Learn"
           class="btn btn-primary-custom">
            ← Back to Learning Modules
        </a>

    </div>

</section>