
@{
    ViewData["Title"] = "Smartphone Basics";
}

<section class="why-section">

    <div class="section-heading">

        <h1>📱 Smartphone Basics</h1>

        <p>
            Learn basic smartphone skills step by step.
        </p>

    </div>


    <div class="feature-grid">

        <!-- Step 1 -->
        <div class="feature-card">

            <div class="feature-icon">🔘</div>

            <h3>Step 1: Turn Your Phone On and Off</h3>

            <p>
                Press and hold the power button to turn your smartphone on.
                To switch it off, press and hold the power button and select
                the power-off option.
            </p>

        </div>


        <!-- Step 2 -->
        <div class="feature-card">

            <div class="feature-icon">📞</div>

            <h3>Step 2: Make and Receive Calls</h3>

            <p>
                Open the Phone app, select a contact or enter a phone number,
                and tap the call button. To answer a call, tap the answer
                option.
            </p>

        </div>


        <!-- Step 3 -->
        <div class="feature-card">

            <div class="feature-icon">👤</div>

            <h3>Step 3: Save a Contact</h3>

            <p>
                Open the Contacts app, select Add Contact, enter the person's
                name and phone number, and save the contact.
            </p>

        </div>


        <!-- Step 4 -->
        <div class="feature-card">

            <div class="feature-icon">💬</div>

            <h3>Step 4: Send a Message</h3>

            <p>
                Open the messaging app, choose a contact, type your message,
                and tap the send button.
            </p>

        </div>


        <!-- Step 5 -->
        <div class="feature-card">

            <div class="feature-icon">🔊</div>

            <h3>Step 5: Adjust Volume and Brightness</h3>

            <p>
                Use the volume buttons to increase or decrease sound.
                Brightness can be adjusted from the phone's quick settings.
            </p>

        </div>


        <!-- Step 6 -->
        <div class="feature-card">

            <div class="feature-icon">📲</div>

            <h3>Step 6: Open and Use Apps</h3>

            <p>
                Tap an app icon to open it. Use the back button or gesture
                to return to the previous screen.
            </p>

        </div>

    </div>


    <!-- Helpful Tip -->

    <div class="about-section">

        <h2>💡 Tip for Senior Citizens</h2>

        <p>
            Practice one skill at a time. If you are unsure about any option,
            ask a trusted family member or trainer for help.
        </p>

        <a href="/Home/Learn"
           class="btn btn-primary-custom back-learning-btn">

            ← Back to Learning Modules

        </a>

    </div>

</section>

