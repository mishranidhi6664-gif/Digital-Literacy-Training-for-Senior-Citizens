@{
    ViewData["Title"] = "Digital Payments";
}

<section class="why-section">

    <div class="section-heading">

        <h1>💳 Digital Payments</h1>

        <p>
            Learn how to make digital payments safely and confidently.
        </p>

    </div>


    <div class="feature-grid">

        <!-- Step 1 -->
        <div class="feature-card">

            <div class="feature-icon">📱</div>

            <h3>Step 1: Open Your Payment App</h3>

            <p>
                Open a trusted payment application such as a UPI payment app
                on your smartphone.
            </p>

        </div>


        <!-- Step 2 -->
        <div class="feature-card">

            <div class="feature-icon">🔢</div>

            <h3>Step 2: Enter Payment Details</h3>

            <p>
                Select the person or service you want to pay and enter the
                required payment details carefully.
            </p>

        </div>


        <!-- Step 3 -->
        <div class="feature-card">

            <div class="feature-icon">📷</div>

            <h3>Step 3: Scan QR Code</h3>

            <p>
                Use the QR scanner in your payment app to scan a trusted
                QR code before making a payment.
            </p>

        </div>


        <!-- Step 4 -->
        <div class="feature-card">

            <div class="feature-icon">🔐</div>

            <h3>Step 4: Enter UPI PIN</h3>

            <p>
                Enter your UPI PIN only on the official payment screen.
                Never share your UPI PIN with anyone.
            </p>

        </div>


        <!-- Step 5 -->
        <div class="feature-card">

            <div class="feature-icon">✅</div>

            <h3>Step 5: Check Payment Status</h3>

            <p>
                After making the payment, check the transaction status and
                keep the confirmation for your records.
            </p>

        </div>


        <!-- Step 6 -->
        <div class="feature-card">

            <div class="feature-icon">⚠️</div>

            <h3>Step 6: Stay Safe</h3>

            <p>
                Never share your OTP, UPI PIN, password or banking details
                with anyone.
            </p>

        </div>

    </div>


    <!-- Safety Tip -->

    <div class="about-section">

        <h2>💡 Safety Tip</h2>

        <p>
            Always verify the receiver's name and payment details before
            confirming a digital payment. Never share your UPI PIN or OTP.
        </p>

        <a href="/Home/Learn"
           class="btn btn-primary-custom">

            ← Back to Learning Modules

        </a>

    </div>

</section>