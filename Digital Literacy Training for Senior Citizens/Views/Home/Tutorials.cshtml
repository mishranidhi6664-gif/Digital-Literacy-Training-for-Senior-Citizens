@{
    ViewData["Title"] = "Digital Literacy Tutorials";
}

<section class="why-section">

    <div class="section-heading">

        <h1>📚 Digital Literacy Tutorials</h1>

        <p>
            Follow these simple tutorials to learn important digital skills
            step by step.
        </p>

    </div>


    <div class="feature-grid">

        <!-- Tutorial 1 -->

        <div class="feature-card">

            <div class="feature-icon">📱</div>

            <h3>1. Smartphone Tutorial</h3>

            <p>
                Learn how to turn your smartphone on and off, make calls,
                save contacts, send messages and use basic apps.
            </p>

            <a href="/Home/Smartphone"
               class="btn btn-primary-custom">

                Start Tutorial

            </a>

        </div>


        <!-- Tutorial 2 -->

        <div class="feature-card">

            <div class="feature-icon">🌐</div>

            <h3>2. Internet Tutorial</h3>

            <p>
                Learn how to connect to the internet, search for information,
                open websites and use online services safely.
            </p>

            <a href="/Home/Internet"
               class="btn btn-primary-custom">

                Start Tutorial

            </a>

        </div>


        <!-- Tutorial 3 -->

        <div class="feature-card">

            <div class="feature-icon">💬</div>

            <h3>3. Communication &amp; WhatsApp</h3>

            <p>
                Learn how to send WhatsApp messages, share photos,
                make voice calls and make video calls.
            </p>

            <a href="/Home/Communication"
               class="btn btn-primary-custom">

                Start Tutorial

            </a>

        </div>


        <!-- Tutorial 4 -->

        <div class="feature-card">

            <div class="feature-icon">💳</div>

            <h3>4. Digital Payments</h3>

            <p>
                Learn how to use UPI, scan QR codes, make digital payments
                and protect your payment information.
            </p>

            <a href="/Home/DigitalPayments"
               class="btn btn-primary-custom">

                Start Tutorial

            </a>

        </div>


        <!-- Tutorial 5 -->

        <div class="feature-card">

            <div class="feature-icon">🔐</div>

            <h3>5. Online Safety</h3>

            <p>
                Learn how to protect yourself from online fraud, fake links,
                scams and unsafe digital activities.
            </p>

            <a href="/Home/OnlineSafety"
               class="btn btn-primary-custom">

                Start Tutorial

            </a>

        </div>

    </div>


    <!-- Tutorial Tip -->

    <div class="about-section">

        <h2>💡 Tutorial Tip</h2>

        <p>
            Learn one topic at a time and practice the steps on your device.
            If you are unsure about anything, ask a trusted family member
            or trainer for help.
        </p>


        <a href="/Home/Learn"
           class="btn btn-primary-custom">

            ← Back to Learning Modules

        </a>

    </div>

</section>
