@{
    ViewData["Title"] = "Digital Literacy Quiz";
}

<section class="why-section">

    <div class="section-heading">

        <h1>📝 Digital Literacy Quiz</h1>

        <p>
            Test your digital skills with these simple questions.
            Select the correct answer and click Submit Quiz.
        </p>

    </div>


    <div class="quiz-container">

        <!-- Question 1 -->
        <div class="quiz-question">
            <h3>1. Which device is commonly used to make calls and access the internet?</h3>

            <label>
                <input type="radio" name="q1" value="1">
                Smartphone
            </label>

            <label>
                <input type="radio" name="q1" value="0">
                Television
            </label>

            <label>
                <input type="radio" name="q1" value="0">
                Refrigerator
            </label>

            <label>
                <input type="radio" name="q1" value="0">
                Fan
            </label>
        </div>


        <!-- Question 2 -->
        <div class="quiz-question">
            <h3>2. What is used to search for information on the internet?</h3>

            <label>
                <input type="radio" name="q2" value="1">
                Search Engine
            </label>

            <label>
                <input type="radio" name="q2" value="0">
                Calculator
            </label>

            <label>
                <input type="radio" name="q2" value="0">
                Camera
            </label>

            <label>
                <input type="radio" name="q2" value="0">
                Music Player
            </label>
        </div>


        <!-- Question 3 -->
        <div class="quiz-question">
            <h3>3. Which application can be used to send messages and make video calls?</h3>

            <label>
                <input type="radio" name="q3" value="1">
                WhatsApp
            </label>

            <label>
                <input type="radio" name="q3" value="0">
                Calculator
            </label>

            <label>
                <input type="radio" name="q3" value="0">
                Calendar
            </label>

            <label>
                <input type="radio" name="q3" value="0">
                Clock
            </label>
        </div>


        <!-- Question 4 -->
        <div class="quiz-question">
            <h3>4. What does UPI help you do?</h3>

            <label>
                <input type="radio" name="q4" value="1">
                Make digital payments
            </label>

            <label>
                <input type="radio" name="q4" value="0">
                Take photographs
            </label>

            <label>
                <input type="radio" name="q4" value="0">
                Play music
            </label>

            <label>
                <input type="radio" name="q4" value="0">
                Increase screen size
            </label>
        </div>


        <!-- Question 5 -->
        <div class="quiz-question">
            <h3>5. What should you do before making a digital payment?</h3>

            <label>
                <input type="radio" name="q5" value="1">
                Check the receiver's name and amount
            </label>

            <label>
                <input type="radio" name="q5" value="0">
                Share your UPI PIN
            </label>

            <label>
                <input type="radio" name="q5" value="0">
                Share your OTP
            </label>

            <label>
                <input type="radio" name="q5" value="0">
                Click unknown links
            </label>
        </div>


        <!-- Question 6 -->
        <div class="quiz-question">
            <h3>6. Should you share your OTP with another person?</h3>

            <label>
                <input type="radio" name="q6" value="0">
                Yes
            </label>

            <label>
                <input type="radio" name="q6" value="1">
                No
            </label>

            <label>
                <input type="radio" name="q6" value="0">
                Only with strangers
            </label>

            <label>
                <input type="radio" name="q6" value="0">
                Always
            </label>
        </div>


        <!-- Question 7 -->
        <div class="quiz-question">
            <h3>7. What should you do if you receive a suspicious link?</h3>

            <label>
                <input type="radio" name="q7" value="1">
                Do not click it
            </label>

            <label>
                <input type="radio" name="q7" value="0">
                Click it immediately
            </label>

            <label>
                <input type="radio" name="q7" value="0">
                Share it with everyone
            </label>

            <label>
                <input type="radio" name="q7" value="0">
                Enter your password
            </label>
        </div>


        <!-- Question 8 -->
        <div class="quiz-question">
            <h3>8. Which information should be kept private?</h3>

            <label>
                <input type="radio" name="q8" value="1">
                Password and PIN
            </label>

            <label>
                <input type="radio" name="q8" value="0">
                Public information
            </label>

            <label>
                <input type="radio" name="q8" value="0">
                Weather information
            </label>

            <label>
                <input type="radio" name="q8" value="0">
                General news
            </label>
        </div>


        <!-- Question 9 -->
        <div class="quiz-question">
            <h3>9. What should you do if someone asks for your bank OTP over the phone?</h3>

            <label>
                <input type="radio" name="q9" value="1">
                Do not share it
            </label>

            <label>
                <input type="radio" name="q9" value="0">
                Share it immediately
            </label>

            <label>
                <input type="radio" name="q9" value="0">
                Send it by message
            </label>

            <label>
                <input type="radio" name="q9" value="0">
                Post it online
            </label>
        </div>


        <!-- Question 10 -->
        <div class="quiz-question">
            <h3>10. What should you do if you are confused about an online activity?</h3>

            <label>
                <input type="radio" name="q10" value="1">
                Ask a trusted person for help
            </label>

            <label>
                <input type="radio" name="q10" value="0">
                Continue without checking
            </label>

            <label>
                <input type="radio" name="q10" value="0">
                Share your password
            </label>

            <label>
                <input type="radio" name="q10" value="0">
                Click unknown links
            </label>
        </div>


        <!-- Submit Button -->

        <div class="quiz-submit">

            <button type="button"
                    class="btn btn-primary-custom"
                    onclick="calculateScore()">

                Submit Quiz

            </button>

        </div>


        <!-- Result -->

        <div id="quizResult" class="quiz-result">
        </div>


        <!-- Back Button -->

        <div class="quiz-back">

            <a href="/Home/Learn"
               class="btn btn-primary-custom">

                ← Back to Learning Modules

            </a>

        </div>

    </div>

</section>


<script>

    function calculateScore() {

        let score = 0;
        let answered = 0;

        for (let i = 1; i <= 10; i++) {

            let selected = document.querySelector(
                'input[name="q' + i + '"]:checked'
            );

            if (selected) {

                answered++;

                if (selected.value === "1") {
                    score++;
                }

            }
        }


        let result = document.getElementById("quizResult");


        if (answered < 10) {

            result.innerHTML =
                "⚠️ Please answer all 10 questions before submitting the quiz.";

            result.className = "quiz-result show";

            return;
        }


        let message = "";

        if (score >= 8) {

            message = "🎉 Excellent! You have a good understanding of digital skills.";

        }
        else if (score >= 5) {

            message = "👍 Good job! Keep practicing your digital skills.";

        }
        else {

            message = "💡 Keep learning! Practice the digital literacy modules again.";

        }


        result.innerHTML =
            "<h2>Your Score: " + score + " / 10</h2>" +
            "<p>" + message + "</p>";

        result.className = "quiz-result show";

    }

</script>
