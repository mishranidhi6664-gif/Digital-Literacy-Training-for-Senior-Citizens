@{
    ViewData["Title"] = "Digital Payments";
}

<section class="why-section">

    <div class="section-heading">
        <h1>💳 Digital Payments</h1>
        <p>
            Learn how to make digital payments safely and confidently.
        </p>
    </div>

    <div class="feature-grid">

        <!-- Step 1 -->
        <div class="feature-card">
            <div class="feature-icon">💰</div>

            <h3>Step 1: What are Digital Payments?</h3>

            <p>
                Digital payments allow you to pay for products and services
                using a smartphone or other digital device without using cash.
            </p>
        </div>

        <!-- Step 2 -->
        <div class="feature-card">
            <div class="feature-icon">📱</div>

            <h3>Step 2: Understand UPI</h3>

            <p>
                UPI allows you to send and receive money through a supported
                banking or payment application.
            </p>
        </div>

        <!-- Step 3 -->
        <div class="feature-card">
            <div class="feature-icon">📷</div>

            <h3>Step 3: Scan a QR Code</h3>

            <p>
                Open your payment application, scan the merchant's QR code,
                enter the required amount and check the details carefully.
            </p>
        </div>

        <!-- Step 4 -->
        <div class="feature-card">
            <div class="feature-icon">🔢</div>

            <h3>Step 4: Enter Payment Details</h3>

            <p>
                Before making a payment, carefully check the recipient's name
                and the amount you are sending.
            </p>
        </div>

        <!-- Step 5 -->
        <div class="feature-card">
            <div class="feature-icon">✅</div>

            <h3>Step 5: Check Payment Status</h3>

            <p>
                After making a payment, check whether the transaction was
                successful and keep the confirmation for your records.
            </p>
        </div>

        <!-- Step 6 -->
        <div class="feature-card">
            <div class="feature-icon">🔐</div>

            <h3>Step 6: Stay Safe</h3>

            <p>
                Never share your UPI PIN, OTP, password or banking details
                with anyone. Only make payments to trusted people and businesses.
            </p>
        </div>

    </div>

    <div class="about-section">

        <h2>🔐 Digital Payment Safety Tip</h2>

        <p>
            Remember: you should never share your UPI PIN or OTP with anyone,
            even if someone claims to be from a bank or payment service.
        </p>

        <a href="/Home/Learn"
           class="btn btn-primary-custom">
            ← Back to Learning Modules
        </a>

    </div>

</section>