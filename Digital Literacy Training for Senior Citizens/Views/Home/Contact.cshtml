@{
    ViewData["Title"] = "Contact Us";
}

<section class="why-section">

    <div class="section-heading">

        <h1>📞 Contact Us</h1>

        <p>
            Have a question or need help with digital learning?
            You can contact us using the information below.
        </p>

    </div>


    <div class="feature-grid">

        <!-- Contact Information -->

        <div class="feature-card">

            <div class="feature-icon">📧</div>

            <h3>Email Support</h3>

            <p>
                For questions or suggestions related to the project,
                you can contact the project team through email.
            </p>

            <p>
                <strong>Email:</strong> IF124061@thesiacollege.com
            </p>

        </div>


        <!-- Training Support -->

        <div class="feature-card">

            <div class="feature-icon">👩‍🏫</div>

            <h3>Training Support</h3>

            <p>
                Senior citizens can ask a trusted family member,
                trainer or support person for help while learning
                digital skills.
            </p>

        </div>


        <!-- Project Help -->

        <div class="feature-card">

            <div class="feature-icon">💻</div>

            <h3>Project Support</h3>

            <p>
                For questions about the learning modules, tutorials,
                quiz or survey, please contact the project team.
            </p>

        </div>


        <!-- Safety Help -->

        <div class="feature-card">

            <div class="feature-icon">🔐</div>

            <h3>Digital Safety</h3>

            <p>
                Never share your OTP, UPI PIN, password or banking
                information with anyone.
            </p>

        </div>

    </div>


    <!-- Contact Section -->

    <div class="about-section">

        <h2>💡 Need Help?</h2>

        <p>
            If you are having difficulty using any digital service,
            ask a trusted family member or digital literacy trainer
            for assistance.
        </p>


        <!-- Back to Home -->

        <a href="/Home/Index"
           class="btn btn-primary-custom">

            ← Back to Home

        </a>

    </div>

</section>
