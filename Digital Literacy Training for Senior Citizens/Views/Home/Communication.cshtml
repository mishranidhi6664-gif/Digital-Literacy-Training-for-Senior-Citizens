@{
    ViewData["Title"] = "Communication & WhatsApp";
}

<section class="why-section">

    <div class="section-heading">

        <h1>💬 Communication & WhatsApp</h1>

        <p>
            Learn how to communicate with family and friends using
            messages, voice calls and video calls.
        </p>

    </div>

    <div class="feature-grid">

        <div class="feature-card">
            <div class="feature-icon">💬</div>
            <h3>Step 1: Send a Message</h3>
            <p>
                Open WhatsApp or your messaging app. Select a contact,
                type your message and tap the send button.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📞</div>
            <h3>Step 2: Make a Voice Call</h3>
            <p>
                Open WhatsApp, select a contact and tap the phone icon
                to make a voice call.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📹</div>
            <h3>Step 3: Make a Video Call</h3>
            <p>
                Select a contact and tap the video camera icon to
                start a video call with family or friends.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📷</div>
            <h3>Step 4: Send Photos</h3>
            <p>
                Tap the attachment or camera option, select a photo
                and send it to your contact.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🎤</div>
            <h3>Step 5: Send Voice Messages</h3>
            <p>
                Press and hold the microphone button to record a
                voice message and release it to send.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">👥</div>
            <h3>Step 6: Use WhatsApp Groups</h3>
            <p>
                Learn how to read messages, send messages and share
                useful information in family or community groups.
            </p>
        </div>

    </div>

    <div class="about-section">

        <h2>🔐 Communication Safety Tip</h2>

        <p>
            Do not share your OTP, password, PIN or other private
            information through messages or calls. Avoid responding
            to unknown contacts or suspicious links.
        </p>

        <a href="/Home/Learn"
           class="btn btn-primary-custom">

            ← Back to Learning Modules

        </a>

    </div>

</section>

            