@{
    ViewData["Title"] = "Learn Digital Skills";
}

<section class="why-section">

    <div class="section-heading">

        <h2>Learn Digital Skills</h2>

        <p>
            Learn useful digital skills through simple and easy-to-follow modules.
        </p>

    </div>


    <div class="feature-grid">


        <!-- Module 1 - Smartphone -->

        <div class="feature-card">

            <div class="feature-icon">📱</div>

            <h3>Smartphone Basics</h3>

            <p>
                Learn how to make calls, send messages, use apps and manage
                basic smartphone settings.
            </p>

            <a href="/Home/Smartphone"
               class="btn btn-primary-custom">
                Start Learning
            </a>

        </div>


        <!-- Module 2 - Internet -->

        <div class="feature-card">

            <div class="feature-icon">🌐</div>

            <h3>Internet Skills</h3>

            <p>
                Learn how to use the internet, search for information and
                access useful online services safely.
            </p>

            <a href="/Home/Internet"
               class="btn btn-primary-custom">
                Start Learning
            </a>

        </div>


        <!-- Module 3 - Communication -->

        <div class="feature-card">

            <div class="feature-icon">💬</div>

            <h3>Communication &amp; WhatsApp</h3>

            <p>
                Learn how to send messages, make video calls and communicate
                with family and friends.
            </p>

            <a href="/Home/Communication"
               class="btn btn-primary-custom">
                Start Learning
            </a>

        </div>


        <!-- Module 4 - Digital Payments -->

        <div class="feature-card">

            <div class="feature-icon">💳</div>

            <h3>Digital Payments</h3>

            <p>
                Learn about UPI, QR codes, digital payments and safe payment
                practices.
            </p>

            <a href="/Home/DigitalPayments"
               class="btn btn-primary-custom">
                Start Learning
            </a>

        </div>


        <!-- Module 5 - Online Safety -->

        <div class="feature-card">

            <div class="feature-icon">🔐</div>

            <h3>Online Safety</h3>

            <p>
                Learn how to protect yourself from online fraud, scams,
                fake links and unsafe online activities.
            </p>

            <a href="/Home/OnlineSafety"
               class="btn btn-primary-custom">
                Start Learning
            </a>

        </div>


    </div>


    <!-- Learning Tip -->

    <div class="about-section">

        <h2>💡 Learning Tip</h2>

        <p>
            Practice one skill at a time. If you are unsure about any option,
            ask a trusted family member or trainer for help.
        </p>

        <a href="/Home/Index"
           class="btn btn-primary-custom">

            ← Back to Home

        </a>

    </div>

</section>