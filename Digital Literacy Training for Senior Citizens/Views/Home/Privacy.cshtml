@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="why-section">

    <div class="section-heading">
        <h1>🔒 Privacy Policy</h1>

        <p>
            Your privacy is important to us. This website is created as part
            of the Digital Literacy Training for Senior Citizens project.
        </p>
    </div>

    <div class="about-section">

        <h2>📋 Information We Collect</h2>

        <p>
            If you complete our survey, the information provided will be used
            only for educational and project-related analysis.
        </p>

        <h2>🔐 Data Safety</h2>

        <p>
            Users should not share sensitive information such as passwords,
            OTPs, PINs or banking details through this website.
        </p>

        <h2>🎓 Project Purpose</h2>

        <p>
            The information collected through the project is intended to help
            understand digital literacy awareness and training needs among
            senior citizens.
        </p>

        <h2>📞 Contact</h2>

        <p>
            For questions regarding this project, please contact the project
            coordinator or institution.
        </p>

        <a href="/Home/Index"
           class="btn btn-primary-custom">
            ← Back to Home
        </a>

    </div>

</section>