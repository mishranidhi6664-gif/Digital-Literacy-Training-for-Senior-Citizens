@{
    ViewData["Title"] = "About Project";
}

<section class="why-section">

    <div class="section-heading">

        <h1>ℹ️ About the Project</h1>

        <p>
            Learn more about our Digital Literacy Training project.
        </p>

    </div>


    <div class="feature-grid">

        <!-- Project Purpose -->

        <div class="feature-card">

            <div class="feature-icon">🎯</div>

            <h3>Project Purpose</h3>

            <p>
                This project is designed to help senior citizens learn
                digital technology in a simple, safe and easy-to-understand way.
            </p>

        </div>


        <!-- Digital Learning -->

        <div class="feature-card">

            <div class="feature-icon">💻</div>

            <h3>Digital Learning</h3>

            <p>
                The website provides step-by-step learning modules covering
                smartphones, internet usage, communication, digital payments
                and online safety.
            </p>

        </div>


        <!-- Benefits -->

        <div class="feature-card">

            <div class="feature-icon">❤️</div>

            <h3>Benefits for Senior Citizens</h3>

            <p>
                Digital literacy can help senior citizens communicate with
                others, access online services and use digital technology
                with greater confidence and independence.
            </p>

        </div>


        <!-- Interactive Learning -->

        <div class="feature-card">

            <div class="feature-icon">📝</div>

            <h3>Interactive Learning</h3>

            <p>
                The project includes tutorials, quizzes and a survey to make
                digital learning more useful and interactive.
            </p>

        </div>


        <!-- Online Safety -->

        <div class="feature-card">

            <div class="feature-icon">🔐</div>

            <h3>Online Safety</h3>

            <p>
                The project also focuses on safe use of technology by providing
                awareness about online fraud, fake links, OTPs, passwords and
                other digital safety practices.
            </p>

        </div>


        <!-- Technology -->

        <div class="feature-card">

            <div class="feature-icon">⚙️</div>

            <h3>Technology Used</h3>

            <p>
                This web application is developed using ASP.NET Core MVC,
                C#, HTML, CSS and Bootstrap.
            </p>

        </div>

    </div>


    <!-- Goal Section -->

    <div class="about-section">

        <h2>🌟 Our Goal</h2>

        <p>
            Our goal is to make digital technology easier to understand
            and safer to use for senior citizens. Through simple learning
            modules and practical guidance, the project encourages confidence,
            independence and responsible use of digital services.
        </p>


        <!-- Back to Home -->

        <a href="/Home/Index"
           class="btn btn-primary-custom">

            ← Back to Home

        </a>

    </div>

</section>
